{
  "name": "robolance-duck-sim",
  "version": "0.4.0",
  "description": "Microduck in a physics simulator: the official trained skills on MuJoCo, a ball-into-goal field and a mission API an agent programs.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test '.build/test/*.test.js'",
    "prepublishOnly": "npm run build",
    "export-viewer": "npm run build && node scripts/export-viewer.mjs"
  },
  "dependencies": {
    "@mujoco/mujoco": "3.13.0",
    "onnxruntime-web": "^1.31.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "lib",
    "assets",
    "examples",
    "viewer",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaikh-amer/robolance.git",
    "directory": "packages/duck-sim"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./node-assets": {
      "types": "./lib/node-assets.d.ts",
      "default": "./lib/node-assets.js"
    },
    "./examples/*": "./examples/*",
    "./package.json": "./package.json",
    "./viewer": {
      "types": "./lib/viewer.d.ts",
      "default": "./lib/viewer.js"
    },
    "./viewer/duck-model": {
      "types": "./viewer/duck-model.d.ts",
      "default": "./viewer/duck-model.js"
    }
  },
  "typesVersions": {
    "*": {
      "viewer": [
        "lib/viewer.d.ts"
      ],
      "viewer/duck-model": [
        "viewer/duck-model.d.ts"
      ]
    }
  }
}
