{
  "name": "robolance-hardware-tools",
  "version": "0.4.0",
  "description": "The agent's hardware tools: compile a sketch, run it in the simulator, run a Microduck mission, simulate any MJCF robot under a controller, inspect the result. Served over MCP.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "robolance-tools": "lib/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test '.build/test/*.test.js'",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "robolance-hardware-sim": "0.2.1",
    "zod": "^3.25.76",
    "robolance-duck-sim": "0.4.0",
    "robolance-mujoco": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaikh-amer/robolance.git",
    "directory": "packages/hardware-tools"
  },
  "publishConfig": {
    "access": "public"
  }
}
